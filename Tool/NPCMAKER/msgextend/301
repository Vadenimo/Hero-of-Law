        public object TagProcess(ZeldaMessage.MessagePreview msg, List<byte> BoxData, float xPos, float yPos, float scale)
        {
            object[] ret = new object[4];
            
            try
            {        
                ret[0] = (object)BoxData;            
                ret[1] = (object)xPos;
                ret[2] = (object)yPos;        
                ret[3] = (object)scale;
                
                if (msg.Box == ZeldaMessage.Data.BoxType.Ocarina)
                {
                    xPos = 128 - 52;
                    yPos = 48 - 39;   
                    scale = GetNewScaleX(msg, BoxData, 0, scale, 169);
                }                
                  
            }
            catch (Exception ex)
            {
                System.Windows.Forms.MessageBox.Show("ERROR IN TAG PROCESS 301: " + ex.Message + Environment.NewLine + ex.StackTrace);
            }
            
            ret[0] = (object)BoxData;            
            ret[1] = (object)xPos;
            ret[2] = (object)yPos;        
            ret[3] = (object)scale;
            return ret;
           
        }
    }
