include System.dll
include System.Drawing.dll
include System.Core.dll
include System.Windows.Forms.dll
include ZeldaMessage.dll
include System.Runtime.dll

using System;
using System.Collections.Generic;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Drawing.Imaging;
using System.Linq;
using System.Runtime.InteropServices;
using System.Text;
using System.IO;
using ZeldaMessage;

namespace MsgExtend
{
    public class Function
    {
        public object TagProcess(ZeldaMessage.MessagePreview msg, Bitmap bmp, List<byte> BoxData, Color textColor, float scale, float xPos, float yPos, int charPos, ZeldaMessage.Data.BoxType BoxType, int choiceType, int iconType)
        {
            byte num_shift = ZeldaMessage.Common.GetByteFromArray(BoxData.ToArray(), charPos + 1);
            
            if (num_shift == 0)
                xPos = 0;
            else
                xPos += num_shift;
            
            charPos += 1;
        
            object[] ret = new object[9];
            
            ret[0] = (object)bmp;
            ret[1] = (object)BoxData;
            ret[2] = (object)textColor;
            ret[3] = (object)scale;
            ret[4] = (object)xPos;
            ret[5] = (object)yPos;
            ret[6] = (object)charPos;
            ret[7] = (object)choiceType;
            ret[8] = (object)iconType;            
            
            return ret;
        }
    }
}


